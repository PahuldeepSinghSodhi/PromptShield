# Copy to .env and adjust. Never commit .env.
PROMPTSHIELD_DATABASE_URL=sqlite:///./promptshield.db
PROMPTSHIELD_API_KEYS=dev-key
PROMPTSHIELD_NER_BACKEND=onnx
PROMPTSHIELD_LLM_PROVIDER=mock
# For a local model: PROMPTSHIELD_LLM_PROVIDER=ollama, PROMPTSHIELD_LLM_BASE_URL=http://localhost:11434
# For any OpenAI-compatible endpoint: PROMPTSHIELD_LLM_PROVIDER=openai_compatible and set the two lines below
# PROMPTSHIELD_LLM_BASE_URL=https://your-endpoint
# PROMPTSHIELD_LLM_API_KEY=your-key
# PROMPTSHIELD_LLM_MODEL=your-model
